---
// Side projects, after plud.net: a logo, the name, one line. The tiles sit in one row that
// scrolls sideways and never moves by itself.
// Each tile opens the GitHub page of the project. A tile with no `href` has no link and no arrow.
// The logos are copies of each project's own icon, in public/assets/side/.
import type { Lang } from "../i18n/ui.ts";
import { t } from "../i18n/utils.ts";
interface Props { lang: Lang }
const tr = t(Astro.props.lang);
const items: { name: string; icon: string; line: string; href?: string }[] = [
  { name: "Inbox Zero", icon: "/assets/side/inbox-zero.png", line: tr("side.inboxZero"), href: "https://github.com/elie222/inbox-zero/pull/3993" },
  { name: "dormouse", icon: "/assets/side/dormouse.svg", line: tr("side.dormouse"), href: "https://github.com/gautierlp/dormouse" },
  { name: "woodpecker", icon: "/assets/side/woodpecker.svg", line: tr("side.woodpecker"), href: "https://github.com/gautierlp/woodpecker" },
  { name: "magpie", icon: "/assets/side/magpie.svg", line: tr("side.magpie"), href: "https://github.com/gautierlp/magpie" },
  { name: "astro-agentation", icon: "/assets/side/agentation.png", line: tr("side.astroAgentation"), href: "https://github.com/gautierlp/astro-agentation" },
];
---
<section class="side" aria-labelledby="side-title">
  <h2 id="side-title">{tr("section.side")}</h2>
  <ul class="side__track" data-side-track tabindex="0" aria-label={tr("section.side")}>
    {items.map((item) => {
      const body = (
        <>
          <img class="tile__icon" src={item.icon} alt="" width="40" height="40" loading="lazy" decoding="async" draggable="false" />
          <span class="tile__copy"><strong>{item.name}</strong><span>{item.line}</span></span>
        </>
      );
      return (
        <li class="side__slide">
          {item.href
            ? <a class="tile" href={item.href} target="_blank" rel="noopener">{body}<svg class="tile__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7" /></svg></a>
            : <div class="tile tile--static">{body}</div>}
        </li>
      );
    })}
  </ul>
</section>
<script is:inline>
// Mouse drag for the row. Touch and trackpad keep the native scroll. No autoplay.
(() => {
  const track = document.querySelector("[data-side-track]");
  if (!track) return;
  let drag = null;
  track.addEventListener("pointerdown", (e) => {
    if (e.pointerType !== "mouse" || e.button !== 0) return;
    drag = { id: e.pointerId, startX: e.clientX, startScroll: track.scrollLeft, moved: false };
  });
  track.addEventListener("pointermove", (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    const dx = e.clientX - drag.startX;
    if (!drag.moved) {
      if (Math.abs(dx) < 6) return;
      drag.moved = true;
      track.setPointerCapture(drag.id);
      track.dataset.dragging = "";
    }
    track.scrollLeft = drag.startScroll - dx;
  });
  function release(e) {
    const d = drag;
    if (!d || e.pointerId !== d.id) return;
    drag = null;
    if (!d.moved) return;
    if (track.hasPointerCapture(d.id)) track.releasePointerCapture(d.id);
    delete track.dataset.dragging;
    track.dataset.swallowClick = "";
    setTimeout(() => delete track.dataset.swallowClick, 0);
  }
  track.addEventListener("pointerup", release);
  track.addEventListener("pointercancel", release);
  // A drag that ends on a tile must not open it.
  track.addEventListener("click", (e) => { if ("swallowClick" in track.dataset) { e.preventDefault(); e.stopPropagation(); } }, true);
})();
</script>
