---
import type { Project } from "../lib/content.ts";
import { slugOf } from "../lib/content.ts";
import type { Lang } from "../i18n/ui.ts";
import { t, localePath } from "../i18n/utils.ts";
interface Props { projects: Project[]; lang: Lang }
const { projects, lang } = Astro.props;
const tr = t(lang);
// Card colour = the background colour of the screenshot, so the image runs into the card.
// "dark" puts white text on the card. A project missing here gets a light grey card.
const tones: Record<string, { bg: string; dark: boolean }> = {
  evaboot: { bg: "#e8e8e8", dark: false },
  "disko-leads": { bg: "#008cfb", dark: true },
  folderly: { bg: "#ff7352", dark: true },
};
const cards = projects.map((p) => {
  const tone = tones[slugOf(p)] ?? { bg: "#f3f3f3", dark: false };
  const still = p.data.images.find((i) => !i.src.endsWith(".mp4"));
  const tagline = [p.data.result, p.data.resultLabel].filter(Boolean).join(" ");
  return { ...tone, name: p.data.name, logo: p.data.logo, image: still?.src, tagline, href: localePath(lang, `/projects/${slugOf(p)}/`) };
});
---
<section class="work" aria-labelledby="work-title">
  <h2 id="work-title">{tr("section.selectedWork")}</h2>
  <ul class="work__track">
    {cards.map((c) => (
      <li class="work__slide">
        <a class="card" href={c.href} style={`--card-bg:${c.bg};--card-fg:${c.dark ? "#ffffff" : "#111111"}`} aria-label={c.tagline ? `${c.name}, ${c.tagline}` : c.name}>
          {c.image && <img class="card__media" src={c.image} alt="" loading="lazy" decoding="async" />}
          <span class="card__copy" aria-hidden="true">
            {c.logo && <img class="card__logo" src={c.logo} alt="" />}
            <span class="card__name">{c.name}</span>
            {c.tagline && <span class="card__tagline">{c.tagline}</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
