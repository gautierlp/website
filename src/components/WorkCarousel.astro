---
import type { UseCase } from "../lib/content.ts";
import { slugOf } from "../lib/content.ts";
import type { Lang } from "../i18n/ui.ts";
import { t, localePath } from "../i18n/utils.ts";
interface Props { useCases: UseCase[]; lang: Lang }
const { useCases, lang } = Astro.props;
const tr = t(lang);
// The picture and logo on each card. "light" cards match the grey behind the laptop mockups.
const EVABOOT_LOGO = "/assets/images/image30.png";
// "place" puts the picture at a set spot, in percent of the card (left, top, width); without it the picture fills the card.
type Place = [number, number, number];
const art: Record<string, { image: string; logo: string; tone: "light" | "dark"; bg: string; place?: Place }> = {
  "no-code-exit": { image: "/assets/projects/evaboot/wcnvcxceeguy7ibzeaos.webp", logo: EVABOOT_LOGO, tone: "light", bg: "#e8e8e8" },
  "interfaces-on-a-new-stack": { image: "/assets/projects/evaboot/yeozsoqcr93m15jqq47s.webp", logo: EVABOOT_LOGO, tone: "light", bg: "#e8e8e8", place: [5, -20, 140] },
  "marketing-site-migration": { image: "/assets/images/image20.jpg", logo: EVABOOT_LOGO, tone: "light", bg: "#e8e8e8", place: [16, -2, 115] },
  "internal-applications": { image: "/assets/projects/parts-marketplace/wcipnwjiikjqyctuxvsx.webp", logo: "", tone: "dark", bg: "#1e1e1e" },
};
const cards = useCases.map((u) => ({
  ...art[slugOf(u)],
  name: u.data.name, summary: u.data.summary, result: u.data.result, resultLabel: u.data.resultLabel,
  href: localePath(lang, `/use-cases/${slugOf(u)}/`),
}));
---
<section class="work" aria-labelledby="work-title">
  <h2 id="work-title">{tr("section.selectedWork")}</h2>
  <ul class="work__track" data-carousel aria-label={tr("section.selectedWork")}>
    {cards.map((c, i) => (
      <li class="work__slide" style={`--d:${i}`}>
        <a class="card" href={c.href} data-tone={c.tone} style={`--card-bg:${c.bg}`} aria-label={`${c.name}. ${c.result} ${c.resultLabel}`}>
          <span class="card__media" data-placed={c.place ? "" : undefined} style={c.place && `left:${c.place[0]}%;top:${c.place[1]}%;width:${c.place[2]}%`} aria-hidden="true"><img src={c.image} alt="" draggable="false" loading={i < 2 ? "eager" : "lazy"} decoding="async" /></span>
          <span class="card__scrim" aria-hidden="true"></span>
          <span class="card__shine" aria-hidden="true"></span>
          <span class="card__copy" aria-hidden="true">
            {c.logo && <img class="card__logo" src={c.logo} alt="" draggable="false" />}
            <span class="card__name">{c.name}</span>
            <span class="card__tagline">{c.summary}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
<script is:inline>
// Rebuilt from plud.net's carousel: --d parallax, cursor light, mouse drag with a
// velocity snap, arrow keys. No sounds, no haptics.
(() => {
  const track = document.querySelector("[data-carousel]");
  if (!track) return;
  const slides = [...track.children];
  const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v));
  const reduced = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let current = 0, frame = 0, drag = null;

  // --d: each slide's distance from the centre, in slides. The CSS moves the picture with it.
  function measure() {
    const centre = track.scrollLeft + track.clientWidth / 2;
    const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
    let best = Infinity;
    slides.forEach((s, i) => {
      const d = (s.offsetLeft + s.offsetWidth / 2 - centre) / (s.offsetWidth + gap);
      s.style.setProperty("--d", clamp(d, -1.5, 1.5).toFixed(4));
      if (Math.abs(d) < best) { best = Math.abs(d); current = i; }
    });
    slides.forEach((s, i) => (i === current ? s.setAttribute("aria-current", "true") : s.removeAttribute("aria-current")));
  }
  const schedule = () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(measure); };
  const leftOf = (i) => slides[i].offsetLeft + slides[i].offsetWidth / 2 - track.clientWidth / 2;
  const go = (i) => track.scrollTo({ left: leftOf(clamp(i, 0, slides.length - 1)), behavior: reduced() ? "instant" : "smooth" });

  track.addEventListener("scroll", schedule, { passive: true });
  window.addEventListener("resize", schedule);
  measure();

  // Cursor light: the pointer position inside the card, in percent.
  track.querySelectorAll(".card").forEach((card) => {
    card.addEventListener("pointermove", (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty("--px", `${(((e.clientX - r.left) / r.width) * 100).toFixed(1)}%`);
      card.style.setProperty("--py", `${(((e.clientY - r.top) / r.height) * 100).toFixed(1)}%`);
    });
    card.addEventListener("focus", () => card.matches(":focus-visible") && go(slides.indexOf(card.parentElement)));
  });

  // Mouse drag. Touch keeps the native swipe.
  track.addEventListener("pointerdown", (e) => {
    if (e.pointerType !== "mouse" || e.button !== 0) return;
    drag = { id: e.pointerId, startX: e.clientX, startScroll: track.scrollLeft, lastX: e.clientX, lastTime: performance.now(), velocity: 0, moved: false };
  });
  track.addEventListener("pointermove", (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    const dx = e.clientX - drag.startX;
    if (!drag.moved) {
      if (Math.abs(dx) < 6) return;
      drag.moved = true;
      track.setPointerCapture(drag.id);
      track.dataset.dragging = "";
    }
    const now = performance.now();
    drag.velocity = 0.6 * drag.velocity + 0.4 * ((e.clientX - drag.lastX) / Math.max(1, now - drag.lastTime));
    drag.lastX = e.clientX; drag.lastTime = now;
    track.scrollLeft = drag.startScroll - dx;
  });
  function release(e) {
    const d = drag;
    if (!d || e.pointerId !== d.id) return;
    drag = null;
    if (!d.moved) return;
    if (track.hasPointerCapture(d.id)) track.releasePointerCapture(d.id);
    // Throw: land on the slide nearest to where the fling would stop.
    const target = track.scrollLeft - 120 * d.velocity;
    let best = 0, dist = Infinity;
    slides.forEach((_, i) => { const x = Math.abs(leftOf(i) - target); if (x < dist) { dist = x; best = i; } });
    // Snap stays off (data-settling) until the smooth scroll lands, else the browser jumps there.
    delete track.dataset.dragging;
    track.dataset.settling = "";
    const settled = () => delete track.dataset.settling;
    track.addEventListener("scrollend", settled, { once: true });
    setTimeout(settled, 1000); // Safari before 26 has no scrollend
    go(best);
    track.dataset.swallowClick = "";
    setTimeout(() => delete track.dataset.swallowClick, 0);
  }
  track.addEventListener("pointerup", release);
  track.addEventListener("pointercancel", release);
  // A drag that ends on a card must not open it.
  track.addEventListener("click", (e) => { if ("swallowClick" in track.dataset) { e.preventDefault(); e.stopPropagation(); } }, true);

  track.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
    e.preventDefault();
    const next = clamp(current + (e.key === "ArrowRight" ? 1 : -1), 0, slides.length - 1);
    go(next);
    slides[next].querySelector("a")?.focus({ preventScroll: true });
  });

  // Autoplay: a slow drift that turns back at each end. The mouse over the track or the
  // keyboard focus inside it holds it; a swipe, wheel or key hands control back for a while.
  // A mouse click also focuses a card, so only :focus-visible counts, and leaving resumes at once.
  // Snap is off while it runs (data-autoplay), else the browser pulls it to a slide each frame.
  if (reduced()) return;
  const SPEED = 18; // px per second
  const IDLE = 4000; // ms after the last interaction before the drift starts again
  let dir = 1, pos = 0, last = 0, hover = false, idleUntil = 0;
  const interrupt = () => { idleUntil = performance.now() + IDLE; delete track.dataset.autoplay; };
  track.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") hover = true; });
  track.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") { hover = false; idleUntil = 0; } });
  track.addEventListener("pointerdown", (e) => { if (e.pointerType !== "mouse") interrupt(); });
  track.addEventListener("wheel", interrupt, { passive: true });
  track.addEventListener("keydown", interrupt);
  function tick(now) {
    const dt = Math.min(now - (last || now), 50) / 1000;
    last = now;
    const held = hover || drag || track.querySelector(":focus-visible") || now < idleUntil;
    // While held, follow the track, so a drag under the mouse is where the drift picks up.
    if (held) pos = track.scrollLeft;
    else {
      if (!("autoplay" in track.dataset)) { track.dataset.autoplay = ""; pos = track.scrollLeft; }
      const max = track.scrollWidth - track.clientWidth;
      pos = clamp(pos + dir * SPEED * dt, 0, max);
      if (pos === max) dir = -1;
      if (pos === 0) dir = 1;
      track.scrollLeft = pos;
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();
</script>
