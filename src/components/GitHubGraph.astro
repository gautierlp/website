---
import { fetchCalendar, lastMonths, level } from "../lib/github.ts";
import type { Lang } from "../i18n/ui.ts";
import { t } from "../i18n/utils.ts";
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
// GitHub gives a year. The graph shows the last 12 months, in the text column, after the side projects.
const year = await fetchCalendar(import.meta.env.GITHUB_TOKEN);
const cal = year && lastMonths(year, 12);
const total = cal ? cal.total.toLocaleString(lang === "fr" ? "fr-FR" : "en-US") : "";
const [beforeTotal, afterTotal] = tr("github.caption").split("{n}");
---
{cal && (
  <section class="gh" aria-labelledby="gh-title">
    <h2 id="gh-title">{tr("github.title")}</h2>
    <div class="gh-body">
      <div class="gh-grid" data-gh-grid data-locale={lang === "fr" ? "fr-FR" : "en-GB"} data-none={tr("github.day.none")} data-one={tr("github.day.one")} data-many={tr("github.day.many")} role="img" aria-label={tr("github.caption").replace("{n}", total)}>
        {cal.weeks.map((week) => (
          <div class="gh-week">
            {week.map((day) => <i class={`gh-day l${level(day.count)}`} data-count={day.count} data-date={day.date}></i>)}
          </div>
        ))}
      </div>
    </div>
    <div class="gh-foot">
      <span class="gh-total">{beforeTotal}<span class="gh-n">{total}</span>{afterTotal}</span>
      <span><a class="gh-link hero__ref" href="https://github.com/gautierlp" target="_blank" rel="noopener">{tr("github.view")}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7" /></svg></a></span>
    </div>
  </section>
)}
<script is:inline>
// The graph is built with the site. This script only adds the label on each day, the
// reveal of the grid and the count of the total. After the graph of creativeatishay.in.
(() => {
  const grid = document.querySelector("[data-gh-grid]");
  if (!grid) return;
  const body = grid.parentElement;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Reveal, the first time the grid is seen: all the days start empty, then the tints fill in,
  // the lightest first and the busiest days last. Each day gets its tint (--lv) and a random number (--n).
  // The total counts up while the grid fills in, fast then slow, as the numbers on the case study pages.
  if (!reduced && "IntersectionObserver" in window) {
    for (const day of grid.querySelectorAll(".gh-day")) {
      day.style.setProperty("--lv", day.className.match(/l(\d)/)?.[1] ?? 0);
      day.style.setProperty("--n", Math.random().toFixed(3));
    }
    const shown = document.querySelector(".gh-n");
    const final = shown && shown.textContent;
    const total = Number(final?.replace(/\D/g, "") || 0);
    const count = (n) => { if (shown) shown.textContent = n.toLocaleString(grid.dataset.locale === "fr-FR" ? "fr-FR" : "en-US"); };
    count(0);
    body.classList.add("gh-wait");
    const io = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      body.classList.replace("gh-wait", "gh-play");
      const start = performance.now();
      const tick = (now) => {
        const k = Math.min(1, Math.max(0, now - start) / 2200);
        count(Math.round(total * (1 - (1 - k) ** 3)));
        if (k < 1) requestAnimationFrame(tick);
        else if (shown) shown.textContent = final;
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.35 });
    io.observe(body);
  }

  // One label for all the days. The mouse hides it on leave; a tap keeps it until a scroll or a tap elsewhere.
  const tip = document.createElement("div");
  tip.className = "gh-tip";
  tip.setAttribute("aria-hidden", "true");
  document.body.appendChild(tip);
  const dates = new Intl.DateTimeFormat(grid.dataset.locale, { day: "numeric", month: "short", year: "numeric" });
  let current = null;
  function hide() {
    if (!current) return;
    current.classList.remove("is-on");
    current = null;
    tip.classList.remove("is-on");
  }
  function show(day) {
    if (day === current) return;
    if (current) current.classList.remove("is-on");
    current = day;
    day.classList.add("is-on");
    const n = Number(day.dataset.count);
    const text = n === 0 ? grid.dataset.none : n === 1 ? grid.dataset.one : grid.dataset.many;
    tip.textContent = text.replace("{n}", n.toLocaleString(grid.dataset.locale)).replace("{date}", dates.format(new Date(day.dataset.date + "T00:00:00")));
    tip.classList.add("is-on");
    const r = day.getBoundingClientRect();
    const w = tip.offsetWidth;
    const edge = 8 + w / 2;
    const x = Math.min(Math.max(r.left + r.width / 2, edge), window.innerWidth - edge);
    tip.style.translate = `${Math.round(x - w / 2)}px ${Math.round(r.top - tip.offsetHeight - 8)}px`;
  }
  grid.addEventListener("pointerover", (e) => {
    const day = e.target.closest(".gh-day");
    // The gaps between the days report the grid itself: keep the label, do not flicker.
    if (day) show(day);
  });
  grid.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") hide(); });
  document.addEventListener("pointerdown", (e) => { if (current && !grid.contains(e.target)) hide(); });
  window.addEventListener("scroll", (e) => { if (e.target === document || e.target === grid) hide(); }, { capture: true, passive: true });
})();
</script>
