---
import type { Lang } from "../i18n/ui.ts";
import { t } from "../i18n/utils.ts";
import BookingLink from "./BookingLink.astro";
interface Props { lang: Lang }
const tr = t(Astro.props.lang);
// Each word of the role gets its own hand-drawn stroke, in turn yellow, pink, green.
const roleWords = tr("hero.role").split(" ");
---
<section class="block hero">
  <img class="avatar" src="/assets/images/avatar.jpg" alt="Gautier Le Poher" width="56" height="56" />
  <h1>
    <span class="hero__line">{tr("hero.hi")}<span class="nowrap">{roleWords.map((w, i) => <>{i > 0 && " "}<span class={`mark mark--${(i % 3) + 1}`}>{w}</span></>)}.</span></span>
    <span class="hero__line">{tr("hero.line1")}</span>
  </h1>
  <p>{tr("hero.p1")}</p>
  <p>{tr("hero.p2")}</p>
  <p>{tr("hero.p3")}<strong>{tr("hero.p3.strong")}</strong></p>
  <div class="hero__actions">
    <BookingLink class="pill">
      <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="3.5" width="11" height="10" rx="2" /><path d="M2.5 6.5h11M5.5 2v3M10.5 2v3" /></svg>
      {tr("hero.book")}
    </BookingLink>
    <p class="status"><span class="status__dot" aria-hidden="true"></span>{tr("hero.available")}</p>
  </div>
</section>
