---
import type { Lang } from "../i18n/ui.ts";
import { localePath, mailto, t } from "../i18n/utils.ts";
import BookingLink from "./BookingLink.astro";
interface Props { lang: Lang }
const tr = t(Astro.props.lang);
// The first "Evaboot" of the proof paragraph links to the Evaboot client page.
const REF = "Evaboot";
const proof = tr("hero.proof");
const at = proof.indexOf(REF);
const refHref = localePath(Astro.props.lang, "/clients/evaboot/");
---
<section class="block hero">
  <img class="avatar" src="/assets/images/avatar.jpg" alt="Gautier Le Poher" width="56" height="56" />
  <h1>
    <span class="hero__line">{tr("hero.hi")}</span>
    <span class="hero__line"><span class="hero__role">{tr("hero.role")}</span>.</span>
    <span class="hero__line">{tr("hero.line1")}</span>
  </h1>
  <p>{at < 0 ? proof : <>{proof.slice(0, at)}<a class="hero__ref" href={refHref}>{REF}</a>{proof.slice(at + REF.length)}</>}</p>
  <p>{tr("hero.problem")}</p>
  <p>{tr("hero.offer")}</p>
  <p><strong>{tr("hero.agents")}</strong></p>
  <div class="hero__actions">
    <BookingLink class="pill">
      <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="3.5" width="11" height="10" rx="2" /><path d="M2.5 6.5h11M5.5 2v3M10.5 2v3" /></svg>
      {tr("hero.book")}
    </BookingLink>
    <p class="hero__mail"><span class="muted">{tr("cta.email")}</span> <a class="hero__ref" href={mailto(Astro.props.lang)}>gautier@lepoher.co</a></p>
  </div>
</section>
