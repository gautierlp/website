---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Media from "./Media.astro";
import PlainList from "./PlainList.astro";
import DraftNote from "./DraftNote.astro";
import { getUseCases, langOf, slugOf, type Project } from "../lib/content.ts";
import type { Lang } from "../i18n/ui.ts";
import { t, localePath, stripLang } from "../i18n/utils.ts";

interface Props { project: Project; lang: Lang }
const { project, lang } = Astro.props;
const d = project.data;
const tr = t(lang);
const pageLang = langOf(project); // "en" when the French file is missing
const { Content } = await render(project);
const isDraft = d.status === "draft";
const isEmpty = project.body === undefined || project.body.trim() === "";
const useCases = (await getUseCases(lang)).filter((u) => d.useCases.includes(slugOf(u)));
const items = useCases.map((u) => ({
  name: u.data.name, summary: u.data.summary,
  href: localePath(lang, `/use-cases/${slugOf(u)}/`),
}));
const title = d.result ? `${d.name}, ${d.result} ${d.resultLabel}` : d.name;
const isFallback = pageLang !== lang;
const canonical = isFallback ? "https://lepoher.co" + stripLang(Astro.url.pathname) : undefined;
---
<BaseLayout lang={pageLang} routeLang={lang} title={`${title} | Gautier Le Poher`} description={d.summary} noindex={isDraft || isFallback} canonical={canonical}>
  <article class="page">
    <header class="page__head">
      <h1>{d.name}</h1>
      {d.result && <p class="muted">{d.result} {d.resultLabel}</p>}
      <p class="muted">{tr("project.client")}: {d.client}</p>
    </header>
    {isDraft && <DraftNote lang={lang} empty={isEmpty} />}
    {d.links.length > 0 && (
      <p class="links">{d.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label}</a>)}</p>
    )}
    {d.images.map((img) => (
      <figure>
        <Media src={img.src} alt={img.alt} />
        <figcaption class="muted">{img.alt}</figcaption>
      </figure>
    ))}
    <div class="prose"><Content /></div>
    {d.quote && (
      <blockquote class="quote">
        <p>&ldquo;{d.quote.text}&rdquo;</p>
        <footer class="muted">{d.quote.who}, {d.quote.role}</footer>
      </blockquote>
    )}
    {items.length > 0 && (
      <section class="block">
        <h2>{tr("project.useCases")}</h2>
        <PlainList items={items} />
      </section>
    )}
  </article>
</BaseLayout>
