---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "./Hero.astro";
import GitHubGraph from "./GitHubGraph.astro";
import PlainList from "./PlainList.astro";
import SideProjects from "./SideProjects.astro";
import WorkCarousel from "./WorkCarousel.astro";
import TestimonialPile from "./TestimonialPile.astro";
import { getCaseStudies, slugOf } from "../lib/content.ts";
import type { Lang } from "../i18n/ui.ts";
import { t, localePath } from "../i18n/utils.ts";
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const studies = await getCaseStudies(lang);
// Selected work: the use-case stories, then the apps marked featured, in Track record order.
const work = [
  ...studies.filter((s) => s.data.kind === "use-case"),
  ...studies.filter((s) => s.data.kind === "app" && s.data.featured && s.data.status === "live"),
];
// One line per app. Drafts with no text stay off the list: they build, but only a direct link reaches them.
const projectItems = studies.filter((s) => s.data.kind === "app" && s.data.status === "live").map((s) => ({
  name: s.data.name,
  nda: s.data.nda,
  note: [s.data.result, s.data.resultLabel].filter(Boolean).join(" "),
  href: localePath(lang, `/case-studies/${slugOf(s)}/`),
}));
---
<BaseLayout lang={lang} routeLang={lang} title={tr("site.title")} description={tr("site.description")}>
  <Hero lang={lang} />
  <WorkCarousel stories={work} lang={lang} />
  <TestimonialPile lang={lang} />
  <section class="block" id="track-record">
    <h2>{tr("section.allApps")}</h2>
    <PlainList items={projectItems} lang={lang} />
  </section>
  <SideProjects lang={lang} />
  <GitHubGraph lang={lang} />
</BaseLayout>
