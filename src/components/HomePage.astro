---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "./Hero.astro";
import GitHubGraph from "./GitHubGraph.astro";
import PlainList from "./PlainList.astro";
import SideProjects from "./SideProjects.astro";
import WorkCarousel from "./WorkCarousel.astro";
import CallToAction from "./CallToAction.astro";
import Quote from "./Quote.astro";
import { getProjects, getUseCases, slugOf } from "../lib/content.ts";
import type { Lang } from "../i18n/ui.ts";
import { t, localePath } from "../i18n/utils.ts";
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const projects = await getProjects(lang);
const useCases = await getUseCases(lang);
// Drafts with no text stay off the list: they build, but only a direct link reaches them.
const projectItems = projects.filter((p) => p.data.status === "live").map((p) => ({
  name: p.data.name,
  nda: p.data.nda,
  note: [p.data.result, p.data.resultLabel].filter(Boolean).join(" "),
  href: localePath(lang, `/projects/${slugOf(p)}/`),
}));
// JB's quote on the Evaboot page stays off the homepage until he agrees to a shorter version.
const quote = projects.find((p) => slugOf(p) === "disko-leads")?.data.quote;
---
<BaseLayout lang={lang} routeLang={lang} title={tr("site.title")} description={tr("site.description")}>
  <Hero lang={lang} />
  <GitHubGraph lang={lang} />
  <WorkCarousel useCases={useCases} lang={lang} />
  {quote && (
    <section class="block">
      <h2>{tr("section.quote")}</h2>
      <Quote quote={quote} />
    </section>
  )}
  <section class="block">
    <h2>{tr("section.allApps")}</h2>
    <PlainList items={projectItems} lang={lang} />
  </section>
  <SideProjects lang={lang} />
  <CallToAction lang={lang} />
</BaseLayout>
