---
import "../styles/global.css";
import { languages, type Lang } from "../i18n/ui.ts";
import { mailto, t, twinPath, stripLang, getLangFromPath, localePath } from "../i18n/utils.ts";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
  routeLang?: Lang;
  canonical?: string;
}
const { lang, title, description, noindex = false, routeLang = getLangFromPath(Astro.url.pathname), canonical: canonicalOverride } = Astro.props;
const tr = t(routeLang);
const site = "https://lepoher.co";
const path = Astro.url.pathname;
const twin = twinPath(path);
const canonical = canonicalOverride ?? site + path;
const enHref = site + stripLang(path);
const frHref = site + (path.startsWith("/fr/") ? path : "/fr" + path);
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light only" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="fr" href={frHref} />
    <meta property="og:site_name" content="Gautier Le Poher" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={site + "/assets/images/card.jpg"} />
    <meta property="og:url" content={canonical} />
    <meta property="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?display=swap&family=Inter:ital,wght@0,400;0,500;0,600;1,400"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="site" id="top">
      <header class="header">
        <a class="header__name" href={routeLang === "fr" ? "/fr/" : "/"}>{tr("nav.home")}</a>
        <a class="header__lang" href={twin.href} hreflang={twin.lang} lang={twin.lang}>{languages[twin.lang]}</a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="footer">
        <nav aria-label={tr("nav.profiles")}>
          <a href="https://www.linkedin.com/in/gautier-le-poher/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://www.malt.fr/profile/gautierlepoher" target="_blank" rel="noopener">Malt</a>
          <a href={mailto(routeLang)}>gautier@lepoher.co</a>
          <a href={localePath(routeLang, "/privacy/")}>{tr("privacy.title")}</a>
          <a href={localePath(routeLang, "/legal/")}>{tr("legal.title")}</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
