{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:unit": "node --experimental-strip-types --test tests/i18n.test.mjs tests/github.test.mjs tests/case-study.test.mjs tests/years.test.mjs",
    "test:site": "node --test tests/site.test.mjs",
    "test": "npm run test:unit && npm run build && npm run test:site",
    "review": "astro dev --host --port 4331"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "astro-agentation": "github:gautierlp/astro-agentation#v1.0.0"
  }
}
