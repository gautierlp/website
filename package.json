{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:unit": "node --experimental-strip-types --test tests/i18n.test.mjs tests/github.test.mjs tests/case-study.test.mjs tests/years.test.mjs",
    "test:site": "node --test tests/site.test.mjs",
    "test": "npm run test:unit && npm run build && npm run test:site",
    "review": "(agentation-mcp server > /dev/null 2>&1 &) && astro dev --host --port 4331"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "agentation": "^3.1.2",
    "agentation-mcp": "^1.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
